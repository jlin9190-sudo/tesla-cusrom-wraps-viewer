{
  "name": "tesla-wrap-preview",
  "version": "0.1.0",
  "description": "3D preview for Tesla Paint Shop custom wrap PNGs, with a CLI for AI agents",
  "type": "module",
  "private": true,
  "bin": {
    "wrap-preview": "bin/wrap-preview.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-assets": "tsx scripts/fetch-assets.ts",
    "build-vehicle": "tsx scripts/build-vehicle.ts",
    "wrap-preview": "node bin/wrap-preview.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlin9190-sudo/tesla-cusrom-wraps-viewer.git"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
